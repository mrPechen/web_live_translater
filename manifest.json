{
  "manifest_version": 3,
  "name": "Call Interpreter EN→RU",
  "version": "0.1.0",
  "description": "Субтитры-перевод и готовые ответы во время звонка в браузере.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Call Interpreter — включить/выключить"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js", "src/demo.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-capture": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Включить/выключить перевод"
    },
    "gen-answer": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Сгенерировать ответ ещё раз"
    }
  }
}
